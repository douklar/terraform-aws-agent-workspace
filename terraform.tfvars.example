# Example variables for local onboarding.
# Copy to terraform.tfvars and adjust. Every value below is optional — the
# module works with no tfvars at all — but these show the common knobs.

aws_region    = "eu-central-1"
name_prefix   = "workspace"
instance_name = "workspace-ec2"
instance_type = "m7i-flex.large"

# Default VPC quickstarts usually need a public IP for outbound bootstrap
# because there is no NAT Gateway. Use false with a private subnet that has
# NAT/proxy egress.
associate_public_ip = true

environment = "dev"
cost_center = "engineering"
owner_email = "owner@example.com"

developer_config = {
  install_vscode      = true
  enable_tailscale    = true
  install_claude_code = true
  install_codex_cli   = false
}

# Root EBS volume. Encryption is controlled by `encryption` below, not here.
# storage = {
#   size_gb               = 30
#   delete_on_termination = false
# }

# Encryption applied to every KMS-aware resource the module manages.
#   "aws-managed"      (default) AWS-owned/managed keys everywhere, no extra cost
#   "customer-managed" one KMS key for everything (module creates it, or set
#                      kms_key_arn to reuse an existing key)
#   "unencrypted"      disables encryption where AWS allows it (EBS volume, SQS)
# encryption = {
#   type        = "customer-managed"
#   kms_key_arn = null # e.g. "arn:aws:kms:eu-central-1:123456789012:key/abc123..."
# }

# Optional environment variables backed by SSM SecureString parameters.
# A null value makes the module create a placeholder parameter (fill in the
# value in SSM after apply). A path value references an existing parameter.
# env_vars = {
#   OPENAI_API_KEY    = null
#   ANTHROPIC_API_KEY = null
#   SHARED_TOKEN      = "/team/shared/SHARED_TOKEN"
# }

# Optional manual AMI copy/export. Both default to off.
# ami_transfer = {
#   enable_copy                 = true
#   copy_target_region          = "us-east-1"
#   enable_export               = true
#   create_export_bucket        = true
#   export_bucket_force_destroy = false # true = allow destroying a non-empty export bucket
#   export_s3_prefix            = "ami-exports"
#   export_disk_format          = "VMDK"
#   export_role_name            = "vmimport"
# }

# Optional automated jobs. Start/stop schedules are always created.
# Cost-generating backup and patching jobs default to disabled.
# scheduler_features = {
#   reconcile       = true
#   daily_snapshots = false
#   weekly_amis     = false
#   monthly_amis    = false
#   backup_cleanup  = false
#   security_update = false
# }

# Optional instance schedule. Times are 24-hour HH:MM values in each window
# timezone. A window may cross midnight (start_time later than stop_time).
# instance_schedule_windows = [
#   {
#     name       = "business_hours"
#     timezone   = "Europe/Berlin"
#     days       = ["MON", "TUE", "WED", "THU", "FRI"]
#     start_time = "09:00"
#     stop_time  = "17:30"
#   }
# ]
